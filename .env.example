# Database (Neon transaction pooler)
DATABASE_URL="postgresql://<user>:<password>@ep-misty-scene-azw1skp0-pooler.c-3.ap-southeast-1.aws.neon.tech:5432/neondb?sslmode=require&connection_limit=5&pool_timeout=20&connect_timeout=15"

# Authentication (Auth.js)
AUTH_SECRET=
NEXTAUTH_URL=
AUTH_URL=

# TOTP Security (32-byte / 64-hex char key for AES-256-GCM encryption of TOTP secrets)
AUTH_TOTP_ENCRYPTION_KEY=

# Resend (email / magic link)
RESEND_API_KEY=
EMAIL_FROM=

# Storage (Backblaze B2)
B2_ENDPOINT=https://s3.ca-east-006.backblazeb2.com
B2_REGION=ca-east-006
B2_BUCKET=ccf-production-media
B2_KEY_ID=
B2_APPLICATION_KEY=

# Sentry (error monitoring)
SENTRY_DSN=

# Application
# Public canonical URL (used for absolute URL generation, OG tags, etc.)
NEXT_PUBLIC_APP_URL=
# Optional custom CDN/media base URL (defaults to "/api/media" if unset)
NEXT_PUBLIC_MEDIA_URL=
